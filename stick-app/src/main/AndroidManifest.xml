<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-feature android:name="android.software.leanback" android:required="true"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>

    <application
        android:name=".stick.StickApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/gamelingo_ikona"
        android:banner="@drawable/gamelingo_banner"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity android:name=".stick.StickHome" android:exported="true"
            android:launchMode="singleTop" android:banner="@drawable/gamelingo_banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".stick.StickPair" android:exported="false"/>
        <activity android:name=".stick.StickGame" android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"/>
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove"/>
    </application>
</manifest>
